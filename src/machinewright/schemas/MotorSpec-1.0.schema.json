{
  "$defs": {
    "ConnectorInterface": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "title": "Family",
          "type": "string"
        },
        "interface_id": {
          "title": "Interface Id",
          "type": "string"
        },
        "kind": {
          "const": "connector",
          "default": "connector",
          "title": "Kind",
          "type": "string"
        },
        "pinout": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Pinout",
          "type": "object"
        },
        "positions": {
          "exclusiveMinimum": 0,
          "title": "Positions",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "family",
        "positions"
      ],
      "title": "ConnectorInterface",
      "type": "object"
    },
    "DutyCycleRating": {
      "additionalProperties": false,
      "description": "Generic duty capability used for compatibility screening.\n\nQualification evidence and machine-specific load spectra intentionally remain\noutside Machinewright.",
      "properties": {
        "ambient_max": {
          "$ref": "#/$defs/Quantity"
        },
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/Quantity"
        },
        "on_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "On Fraction"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "cycle_id",
        "duration",
        "on_fraction",
        "ambient_max"
      ],
      "title": "DutyCycleRating",
      "type": "object"
    },
    "ElectricalInterface": {
      "additionalProperties": false,
      "properties": {
        "continuous_current": {
          "$ref": "#/$defs/Quantity"
        },
        "interface_id": {
          "title": "Interface Id",
          "type": "string"
        },
        "kind": {
          "const": "electrical",
          "default": "electrical",
          "title": "Kind",
          "type": "string"
        },
        "peak_current": {
          "$ref": "#/$defs/Quantity"
        },
        "phases": {
          "exclusiveMinimum": 0,
          "title": "Phases",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "voltage": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "interface_id",
        "phases",
        "voltage",
        "continuous_current",
        "peak_current"
      ],
      "title": "ElectricalInterface",
      "type": "object"
    },
    "FeedbackInterface": {
      "additionalProperties": false,
      "properties": {
        "feedback_type": {
          "title": "Feedback Type",
          "type": "string"
        },
        "interface_id": {
          "title": "Interface Id",
          "type": "string"
        },
        "kind": {
          "const": "feedback",
          "default": "feedback",
          "title": "Kind",
          "type": "string"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "resolution": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "feedback_type"
      ],
      "title": "FeedbackInterface",
      "type": "object"
    },
    "ManufacturerPartIdentity": {
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "minLength": 1,
          "title": "Manufacturer",
          "type": "string"
        },
        "part_number": {
          "minLength": 1,
          "title": "Part Number",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "manufacturer",
        "part_number"
      ],
      "title": "ManufacturerPartIdentity",
      "type": "object"
    },
    "MechanicalMountInterface": {
      "additionalProperties": false,
      "properties": {
        "bolt_circle_diameter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tolerance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fastener_count": {
          "exclusiveMinimum": 0,
          "title": "Fastener Count",
          "type": "integer"
        },
        "interface_id": {
          "title": "Interface Id",
          "type": "string"
        },
        "kind": {
          "const": "mechanical_mount",
          "default": "mechanical_mount",
          "title": "Kind",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "pilot_diameter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tolerance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "pattern",
        "fastener_count"
      ],
      "title": "MechanicalMountInterface",
      "type": "object"
    },
    "MotorOperatingPoint": {
      "additionalProperties": false,
      "description": "A guaranteed torque envelope at or below a stated motor speed.",
      "properties": {
        "continuous_torque": {
          "$ref": "#/$defs/Quantity"
        },
        "peak_torque": {
          "$ref": "#/$defs/Quantity"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "speed": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "speed",
        "continuous_torque",
        "peak_torque"
      ],
      "title": "MotorOperatingPoint",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "ShaftInterface": {
      "additionalProperties": false,
      "properties": {
        "diameter": {
          "$ref": "#/$defs/Tolerance"
        },
        "feature": {
          "default": "plain",
          "enum": [
            "plain",
            "key",
            "flat",
            "spline"
          ],
          "title": "Feature",
          "type": "string"
        },
        "interface_id": {
          "title": "Interface Id",
          "type": "string"
        },
        "kind": {
          "const": "shaft",
          "default": "shaft",
          "title": "Kind",
          "type": "string"
        },
        "length": {
          "$ref": "#/$defs/Tolerance"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "diameter",
        "length"
      ],
      "title": "ShaftInterface",
      "type": "object"
    },
    "ThermalInterface": {
      "additionalProperties": false,
      "properties": {
        "ambient_max": {
          "$ref": "#/$defs/Quantity"
        },
        "ambient_min": {
          "$ref": "#/$defs/Quantity"
        },
        "insulation_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Insulation Class"
        },
        "interface_id": {
          "title": "Interface Id",
          "type": "string"
        },
        "kind": {
          "const": "thermal",
          "default": "thermal",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensor"
        }
      },
      "required": [
        "interface_id",
        "ambient_min",
        "ambient_max"
      ],
      "title": "ThermalInterface",
      "type": "object"
    },
    "Tolerance": {
      "additionalProperties": false,
      "properties": {
        "minus": {
          "$ref": "#/$defs/Quantity"
        },
        "nominal": {
          "$ref": "#/$defs/Quantity"
        },
        "plus": {
          "$ref": "#/$defs/Quantity"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "nominal",
        "minus",
        "plus"
      ],
      "title": "Tolerance",
      "type": "object"
    },
    "Unit": {
      "enum": [
        "mm",
        "m",
        "g",
        "kg",
        "V",
        "A",
        "ohm",
        "mH",
        "H",
        "N*m",
        "rpm",
        "rad/s",
        "kg*m^2",
        "g*cm^2",
        "degC",
        "W",
        "g/cm^3",
        "kg/m^3",
        "s"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "back_emf_constant": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Back Emf Constant"
    },
    "brake": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brake"
    },
    "continuous_torque": {
      "$ref": "#/$defs/Quantity"
    },
    "datasheet_revision": {
      "title": "Datasheet Revision",
      "type": "string"
    },
    "duty_cycle": {
      "anyOf": [
        {
          "$ref": "#/$defs/DutyCycleRating"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identity": {
      "$ref": "#/$defs/ManufacturerPartIdentity"
    },
    "inductance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "interfaces": {
      "items": {
        "discriminator": {
          "mapping": {
            "connector": "#/$defs/ConnectorInterface",
            "electrical": "#/$defs/ElectricalInterface",
            "feedback": "#/$defs/FeedbackInterface",
            "mechanical_mount": "#/$defs/MechanicalMountInterface",
            "shaft": "#/$defs/ShaftInterface",
            "thermal": "#/$defs/ThermalInterface"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MechanicalMountInterface"
          },
          {
            "$ref": "#/$defs/ShaftInterface"
          },
          {
            "$ref": "#/$defs/ElectricalInterface"
          },
          {
            "$ref": "#/$defs/FeedbackInterface"
          },
          {
            "$ref": "#/$defs/ThermalInterface"
          },
          {
            "$ref": "#/$defs/ConnectorInterface"
          }
        ]
      },
      "title": "Interfaces",
      "type": "array"
    },
    "mass": {
      "$ref": "#/$defs/Quantity"
    },
    "max_speed": {
      "$ref": "#/$defs/Quantity"
    },
    "motor_type": {
      "title": "Motor Type",
      "type": "string"
    },
    "peak_torque": {
      "$ref": "#/$defs/Quantity"
    },
    "resistance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rotor_inertia": {
      "$ref": "#/$defs/Quantity"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "torque_constant": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Torque Constant"
    },
    "torque_speed_curve": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MotorOperatingPoint"
      },
      "title": "Torque Speed Curve",
      "type": "array"
    }
  },
  "required": [
    "identity",
    "datasheet_revision",
    "motor_type",
    "mass",
    "rotor_inertia",
    "continuous_torque",
    "peak_torque",
    "max_speed",
    "interfaces"
  ],
  "title": "MotorSpec",
  "type": "object"
}
