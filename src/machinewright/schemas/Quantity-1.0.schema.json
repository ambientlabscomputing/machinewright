{
  "$defs": {
    "Unit": {
      "enum": [
        "mm",
        "m",
        "g",
        "kg",
        "V",
        "A",
        "ohm",
        "mH",
        "H",
        "N*m",
        "rpm",
        "rad/s",
        "kg*m^2",
        "g*cm^2",
        "degC",
        "W",
        "g/cm^3",
        "kg/m^3",
        "s"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "unit": {
      "$ref": "#/$defs/Unit"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "value",
    "unit"
  ],
  "title": "Quantity",
  "type": "object"
}
