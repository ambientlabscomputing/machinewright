{
  "$defs": {
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Unit": {
      "enum": [
        "mm",
        "m",
        "g",
        "kg",
        "V",
        "A",
        "ohm",
        "mH",
        "H",
        "N*m",
        "rpm",
        "rad/s",
        "kg*m^2",
        "g*cm^2",
        "degC",
        "W",
        "g/cm^3",
        "kg/m^3",
        "s"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Generic duty capability used for compatibility screening.\n\nQualification evidence and machine-specific load spectra intentionally remain\noutside Machinewright.",
  "properties": {
    "ambient_max": {
      "$ref": "#/$defs/Quantity"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "duration": {
      "$ref": "#/$defs/Quantity"
    },
    "on_fraction": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "On Fraction"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "cycle_id",
    "duration",
    "on_fraction",
    "ambient_max"
  ],
  "title": "DutyCycleRating",
  "type": "object"
}
