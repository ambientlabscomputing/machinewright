{
  "$defs": {
    "OrderStatus": {
      "enum": [
        "to_order",
        "ordered",
        "received",
        "on_hand"
      ],
      "title": "OrderStatus",
      "type": "string"
    },
    "ProcurementEntry": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sku": {
          "default": "",
          "title": "Sku",
          "type": "string"
        },
        "spares": {
          "default": 0,
          "minimum": 0,
          "title": "Spares",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/OrderStatus",
          "default": "to_order"
        },
        "supplier": {
          "default": "",
          "title": "Supplier",
          "type": "string"
        },
        "unit_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Cost"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        }
      },
      "title": "ProcurementEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "lines": {
      "additionalProperties": {
        "$ref": "#/$defs/ProcurementEntry"
      },
      "title": "Lines",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "ProcurementFile",
  "type": "object"
}
