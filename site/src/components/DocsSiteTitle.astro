---
import mark from '../assets/mark.svg?url';
const base = import.meta.env.BASE_URL;
---
<a href={base} class="site-title" style="display:flex;align-items:center;gap:.6rem;text-decoration:none;color:var(--sl-color-white);font-weight:650;">
  <img src={mark} alt="" width="26" height="26" />
  <span>Machinewright</span>
</a>
