{
  "name": "@machinewright/app",
  "version": "0.0.0",
  "private": true,
  "description": "Machinewright IDE — React Native macOS application (RFD-19)",
  "scripts": {
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "generate:model": "node scripts/generate-model.mjs",
    "generate:web-tokens": "node scripts/generate-web-tokens.mjs",
    "generate": "npm run generate:protocol && npm run generate:model && npm run generate:web-tokens",
    "build:web:editor": "node scripts/build-web-editor.mjs",
    "build:web:viewport": "node scripts/build-web-viewport.mjs",
    "build:web:analysis": "node scripts/build-web-analysis.mjs",
    "build:web": "npm run build:web:editor && npm run build:web:viewport && npm run build:web:analysis",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:app": "jest",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "start": "react-native start",
    "macos": "react-native run-macos"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@react-native/new-app-screen": "0.81.6",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "^0.81.9",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-webview": "^14.0.1",
    "smol-toml": "^1.8.0",
    "text-encoding": "^0.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@bufbuild/protoc-gen-es": "^2.2.3",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.4",
    "@types/react-test-renderer": "^19.1.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^29.6.3",
    "json-schema-to-typescript": "^15.0.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
